# Credenciais mockadas do painel administrativo (/admin).
# ATENÇÃO: variáveis VITE_* são embutidas no bundle do cliente — isto delimita
# acesso da equipe, não é segurança real.
# Sem estas variáveis, o fallback em src/lib/auth.ts vale: admin / ipr2025
VITE_ADMIN_USER=admin
VITE_ADMIN_PASSWORD=ipr2025
