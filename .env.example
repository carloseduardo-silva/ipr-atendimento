# Conexão com o projeto Supabase.
# ATENÇÃO: variáveis VITE_* são embutidas no bundle do cliente. Use apenas a
# chave anônima (anon key) aqui — nunca a service_role. Quem protege os dados
# são as policies de RLS da tabela `pacientes_fila`.
VITE_SUPABASE_URL=sua_url_aqui
VITE_SUPABASE_ANON_KEY=sua_chave_aqui

# O acesso ao painel /admin é gerido pelo Supabase Auth (e-mail + senha).
# Crie ou remova usuários da equipe no Dashboard, em Authentication > Users.
